# Optional live-layer credentials for `npm run dev` / `npm run preview`.
# Copy to `.env` (gitignored). Never commit real keys.
# Restart the Vite server after changing these.

# AISStream (https://aisstream.io) — free key required for the AIS globe layer.
# Without it the AIS toggle shows ERR and no vessel positions are invented.
AISSTREAM_API_KEY=

# OpenSky ADS-B (https://opensky-network.org)
# Preferred (current API): OAuth2 client credentials from the OpenSky account page.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Legacy Basic Auth. OpenSky stopped accepting username/password for REST in 2026;
# if set, Overwatch still sends them, but a 401 is an honest failure — not fake tracks.
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# NASA FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
# Optional. The wildfire layer tries the public 24h VIIRS CSV first (no key).
# Set this if that public file is blocked; without a working source the layer is ERR.
FIRMS_MAP_KEY=
